{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sc-mv-dmer.local/schemas/dataset_manifest.schema.json",
  "title": "DEAM primary dataset manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "manifest_id", "dataset_name", "dataset_version", "dataset_id", "inventory_logical_path", "inventory_sha256", "primary_records", "primary_song_keys", "long_song_keys", "primary_population_count", "long_song_count", "manifest_sha256"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "manifest_id": {"const": "DEAM-PRIMARY-v1"},
    "dataset_name": {"const": "DEAM"},
    "dataset_version": {"type": "string", "minLength": 1},
    "dataset_id": {"type": "string", "minLength": 1},
    "inventory_logical_path": {"type": "string", "pattern": "^(?![A-Za-z]:)(?!/)(?!.*\\.\\.).+"},
    "inventory_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "primary_records": {"type": "array", "minItems": 1744, "maxItems": 1744},
    "primary_song_keys": {"type": "array", "minItems": 1744, "maxItems": 1744},
    "long_song_keys": {"type": "array", "minItems": 58, "maxItems": 58},
    "primary_population_count": {"const": 1744},
    "long_song_count": {"const": 58},
    "manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
