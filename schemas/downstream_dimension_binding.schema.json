{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sc-mv-dmer.local/schemas/downstream_dimension_binding.schema.json",
  "title": "MERT downstream dimension binding",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "binding_id",
    "qualification_id",
    "predecessor_qualification",
    "predecessor_qualification_sha256",
    "e1_1_evidence_sha256",
    "upstream_manifest_sha256",
    "temporal_geometry",
    "temporal_geometry_sha256",
    "observed_t_raw",
    "observed_fps",
    "hidden_dimension",
    "timesnet_raw_temporal_input_dimension",
    "timesnet_period_interpretation",
    "required_temporal_reduction",
    "canonical_downstream_t",
    "nodes",
    "edges",
    "all_downstream_temporal_dimensions",
    "forbidden_downstream_actions",
    "derivation_verdict",
    "binding_sha256"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "binding_id": {"const": "MERT-DOWNSTREAM-DIMENSIONS-v1"},
    "qualification_id": {"const": "E1-2-MERT-DOWNSTREAM-DIMENSION-DERIVATION-v1"},
    "predecessor_qualification_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "e1_1_evidence_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "upstream_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "temporal_geometry_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "observed_t_raw": {"type": "integer", "const": 3374},
    "observed_fps": {"type": "number", "exclusiveMinimum": 0},
    "hidden_dimension": {"type": "integer", "const": 768},
    "timesnet_raw_temporal_input_dimension": {"type": "integer", "const": 3374},
    "canonical_downstream_t": {"type": "integer", "const": 90},
    "derivation_verdict": {"const": "PASS"},
    "binding_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "forbidden_downstream_actions": {
      "type": "array",
      "contains": {"const": "MERT_T_RAW_REWRITE"},
      "minItems": 6
    },
    "nodes": {"type": "array", "minItems": 1},
    "edges": {"type": "array", "minItems": 1},
    "all_downstream_temporal_dimensions": {"type": "object"}
  }
}
