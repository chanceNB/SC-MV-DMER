{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sc-mv-dmer.local/schemas/e0_minimum_qualification.schema.json",
  "title": "E0MinimumQualificationBundle",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "implementation_git_commit", "observed_git_dirty", "config_schema_version", "research_spec_version", "semantic_config_hash", "resolved_config_hash", "variants_catalog_sha256", "stages_catalog_sha256", "full_catalog_blocker", "full_catalog_blocker_deferred", "stage_authority_coverage", "probe_manifest_id", "probe_manifest_sha256", "dataset_id", "song_id", "sample_id", "source_relative_path", "source_sha256", "probe_seconds", "target_sample_rate_hz", "target_sample_count", "probe_preparation_status", "mert_repository", "mert_revision", "mert_upstream_identity", "mert_local_verification_status", "e0_implementation_status", "e1_1_readiness", "e1_1_blocked_roles", "e1_1_blocked_reasons", "e1_1_prerequisite_validity", "formal_execution_ready", "paper_eligible", "supersedes", "correction_reason", "qualification_sha256"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "implementation_git_commit": {"type": "string", "minLength": 7},
    "observed_git_dirty": {"type": "boolean"},
    "config_schema_version": {"type": "string", "minLength": 1},
    "research_spec_version": {"type": "string", "minLength": 1},
    "semantic_config_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "resolved_config_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "variants_catalog_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "stages_catalog_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "full_catalog_blocker": {"const": "IMPLEMENTATION_BLOCKED_BY_FROZEN_CONTRACT: SGA-M0M20-EV-3R+"},
    "full_catalog_blocker_deferred": {"const": true},
    "stage_authority_coverage": {"type": "array", "items": {"type": "string"}},
    "probe_manifest_id": {"type": "string", "minLength": 1},
    "probe_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "dataset_id": {"type": "string", "minLength": 1},
    "song_id": {"type": "string", "minLength": 1},
    "sample_id": {"type": "string", "minLength": 1},
    "source_relative_path": {"type": "string", "minLength": 1},
    "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "probe_seconds": {"const": 45},
    "target_sample_rate_hz": {"const": 24000},
    "target_sample_count": {"const": 1080000},
    "probe_preparation_status": {"const": "SPECIFIED_NOT_EXECUTED"},
    "mert_repository": {"const": "m-a-p/MERT-v1-95M"},
    "mert_revision": {"const": "12af15fef9d0ac838c3f475bfbbf26d2060dd4f5"},
    "mert_upstream_identity": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "mert_local_verification_status": {"type": "string", "minLength": 1},
    "e0_implementation_status": {"const": "COMPLETE"},
    "e1_1_readiness": {"enum": ["READY", "BLOCKED"]},
    "e1_1_blocked_roles": {"type": "array", "items": {"type": "string"}},
    "e1_1_blocked_reasons": {"type": "array", "items": {"type": "string"}},
    "e1_1_prerequisite_validity": {"type": "object", "additionalProperties": {"enum": ["VALID", "NOT_VALID"]}},
    "formal_execution_ready": {"type": "boolean"},
    "paper_eligible": {"const": false},
    "supersedes": {"type": ["string", "null"]},
    "correction_reason": {"type": ["string", "null"]},
    "qualification_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
