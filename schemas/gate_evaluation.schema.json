{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sc-mv-dmer.local/schemas/gate_evaluation.schema.json",
  "title": "GateEvaluationAttempt",
  "type": "object",
  "additionalProperties": false,
  "required": ["evaluation_id", "gate_version", "attempt_number", "definition_id", "verdict", "authority_kind", "authority_metadata", "evidence_commit", "evidence_bundle_sha256", "source_run_ids", "predecessor_dependencies"],
  "properties": {
    "evaluation_id": {"type": "string", "minLength": 1},
    "gate_version": {"type": "string", "minLength": 1},
    "attempt_number": {"type": "integer", "minimum": 1},
    "definition_id": {"type": "string", "minLength": 1},
    "verdict": {"enum": ["PASS", "FAIL", "BLOCKED", "INSUFFICIENT_EVIDENCE"]},
    "authority_kind": {"enum": ["automatic", "manual"]},
    "authority_metadata": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["authority_kind", "automation_identity"],
          "properties": {
            "authority_kind": {"const": "automatic"},
            "automation_identity": {"type": "string", "minLength": 1}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["authority_kind", "approval_state"],
          "properties": {
            "authority_kind": {"const": "manual"},
            "approval_state": {"enum": ["PENDING", "APPROVED"]},
            "reviewer_identity": {"type": "string", "minLength": 1},
            "approval_artifact_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
          },
          "allOf": [
            {
              "if": {"properties": {"approval_state": {"const": "APPROVED"}}},
              "then": {"required": ["reviewer_identity", "approval_artifact_sha256"]}
            }
          ]
        }
      ]
    },
    "evidence_commit": {"type": "string", "minLength": 7},
    "evidence_bundle_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_run_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "predecessor_dependencies": {"type": "array", "items": {"type": "string", "minLength": 1}}
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "authority_kind": {"const": "manual"},
          "verdict": {"const": "PASS"}
        },
        "required": ["authority_kind", "verdict"]
      },
      "then": {
        "properties": {
          "authority_metadata": {
            "properties": {"approval_state": {"const": "APPROVED"}},
            "required": ["approval_state", "reviewer_identity", "approval_artifact_sha256"]
          }
        }
      }
    }
  ]
}
