{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sc-mv-dmer.local/schemas/mert_timegrid_binding.schema.json",
  "title": "MERT 2 Hz TimeGrid binding",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "binding_id",
    "qualification_id",
    "predecessor_qualification",
    "dimension_binding_sha256",
    "temporal_geometry",
    "temporal_geometry_sha256",
    "sample_rate_hz",
    "input_sample_count",
    "raw_frame_count",
    "expected_frame_count",
    "bin_count",
    "bins",
    "frames",
    "assigned_frame_count",
    "unassigned_frame_count",
    "duplicate_assignment_count",
    "bin_frame_counts",
    "valid_bin_count",
    "aggregation_rule",
    "bin_boundary_rule",
    "assignment_formula",
    "forbidden_operations",
    "mapping_verdict",
    "binding_sha256"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "binding_id": {"const": "MERT-2HZ-TIMEGRID-v1"},
    "qualification_id": {"const": "E1-3-MERT-TIMEGRID-2HZ-BINDING-v1"},
    "predecessor_qualification_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "dimension_binding_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "temporal_geometry_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "sample_rate_hz": {"type": "integer", "const": 24000},
    "input_sample_count": {"type": "integer", "const": 1080000},
    "raw_frame_count": {"type": "integer", "const": 3374},
    "expected_frame_count": {"type": "integer", "const": 3374},
    "bin_count": {"type": "integer", "const": 90},
    "bins": {"type": "array", "minItems": 90, "maxItems": 90},
    "frames": {"type": "array", "minItems": 3374, "maxItems": 3374},
    "assigned_frame_count": {"type": "integer", "const": 3374},
    "unassigned_frame_count": {"type": "integer", "const": 0},
    "duplicate_assignment_count": {"type": "integer", "const": 0},
    "bin_frame_counts": {"type": "array", "minItems": 90, "maxItems": 90},
    "valid_bin_count": {"type": "integer", "const": 90},
    "aggregation_rule": {"const": "MEAN_OVER_ASSIGNED_VALID_FRAMES"},
    "bin_boundary_rule": {"const": "HALF_OPEN_SAMPLE_DOMAIN"},
    "forbidden_operations": {"type": "array", "minItems": 9},
    "mapping_verdict": {"const": "PASS"},
    "binding_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
