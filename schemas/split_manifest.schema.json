{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sc-mv-dmer.local/schemas/split_manifest.schema.json",
  "title": "Frozen DEAM primary song split",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "split_manifest_id", "split_contract_id", "dataset_manifest_id", "dataset_manifest_logical_path", "dataset_manifest_sha256", "dataset_manifest_file_sha256", "primary_population_count", "train_count", "validation_count", "test_count", "train_song_ids", "validation_song_ids", "test_song_ids", "records", "canonicalization", "split_sha256"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "split_manifest_id": {"const": "primary-song-80-10-10-v1"},
    "split_contract_id": {"const": "DEAM-PRIMARY-SONG-SPLIT/v1"},
    "dataset_manifest_id": {"const": "DEAM-PRIMARY-v1"},
    "dataset_manifest_logical_path": {"type": "string", "pattern": "^(?![A-Za-z]:)(?!/)(?!.*\\.\\.).+"},
    "dataset_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "dataset_manifest_file_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "primary_population_count": {"const": 1744},
    "train_count": {"const": 1395},
    "validation_count": {"const": 174},
    "test_count": {"const": 175},
    "train_song_ids": {"type": "array", "minItems": 1395, "maxItems": 1395, "items": {"type": "string"}},
    "validation_song_ids": {"type": "array", "minItems": 174, "maxItems": 174, "items": {"type": "string"}},
    "test_song_ids": {"type": "array", "minItems": 175, "maxItems": 175, "items": {"type": "string"}},
    "records": {"type": "array", "minItems": 1744, "maxItems": 1744, "items": {"type": "object", "additionalProperties": false, "required": ["song_id", "sample_id", "logical_song_key", "split", "rank_digest", "rank_index"], "properties": {"song_id": {"type": "string"}, "sample_id": {"type": "string"}, "logical_song_key": {"type": "string", "pattern": "^[0-9]+$"}, "split": {"enum": ["train", "validation", "test"]}, "rank_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "rank_index": {"type": "integer", "minimum": 0}}}},
    "canonicalization": {"type": "object", "additionalProperties": true},
    "split_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
